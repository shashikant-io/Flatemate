{
  "name": "flatmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:host": "npm run dev --workspace=apps/web -- --host",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}

