rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(flatId) {
      return request.auth != null
        && request.auth.token.flatId == flatId
        && request.auth.token.member != null;
    }

    function callerMember() {
      return request.auth.token.member;
    }

    function memberExists(flatId, memberId) {
      return exists(/databases/$(database)/documents/flats/$(flatId)/members/$(memberId));
    }

    function monthClosed(flatId, month) {
      return exists(/databases/$(database)/documents/flats/$(flatId)/statements/$(month));
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /flats/{flatId} {
      allow read: if isMember(flatId);
      allow write: if false;

      match /private/{document} {
        allow read, write: if false;
      }

      match /members/{memberId} {
        allow read: if isMember(flatId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(flatId);
        allow create: if isMember(flatId)
          && memberExists(flatId, request.resource.data.paidBy)
          && request.resource.data.createdBy == callerMember()
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.amountPaise <= 1000000000
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1
          && request.resource.data.item.size() <= 80
          && (request.resource.data.type == 'shared' || request.resource.data.type == 'personal')
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.month == request.resource.data.date.substring(0, 7)
          && !monthClosed(flatId, request.resource.data.month);
        allow update: if isMember(flatId)
          && memberExists(flatId, request.resource.data.paidBy)
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1
          && request.resource.data.item.size() <= 80
          && !monthClosed(flatId, resource.data.month)
          && !monthClosed(flatId, request.resource.data.month);
        allow delete: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isMember(flatId);
        allow create: if isMember(flatId)
          && memberExists(flatId, request.resource.data.from)
          && memberExists(flatId, request.resource.data.to)
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.createdBy == callerMember();
        allow update: if isMember(flatId)
          && memberExists(flatId, request.resource.data.from)
          && memberExists(flatId, request.resource.data.to)
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0;
        allow delete: if false;
      }

      match /statements/{month} {
        allow read: if isMember(flatId);
        allow write: if false;
      }
    }
  }
}
